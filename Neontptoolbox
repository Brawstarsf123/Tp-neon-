-- Notification
local function notify(message)
    local note = Instance.new("TextLabel")
    note.Size = UDim2.fromOffset(260, 42)
    note.Position = UDim2.new(0.5, -130, 0, -60)
    note.BackgroundColor3 = Color3.fromRGB(28, 30, 52)
    note.TextColor3 = WHITE
    note.Text = "✦  " .. message
    note.Font = Enum.Font.GothamBold
    note.TextSize = 13
    note.Parent = gui

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = note

    local s = Instance.new("UIStroke")
    s.Color = PURPLE
    s.Thickness = 1.5
    s.Parent = note

    TweenService:Create(note, TweenInfo.new(0.3), {
        Position = UDim2.new(0.5, -130, 0, 20)
    }):Play()

    task.delay(2, function()
        if note.Parent then
            local t = TweenService:Create(note, TweenInfo.new(0.3), {
                Position = UDim2.new(0.5, -130, 0, -60)
            })
            t:Play()
            t.Completed:Wait()
            note:Destroy()
        end
    end)
end

-- Buttons
local function makeButton(text, y, color, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -30, 0, 43)
    b.Position = UDim2.fromOffset(15, y)
    b.BackgroundColor3 = color
    b.Text = text
    b.TextColor3 = WHITE
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.AutoButtonColor = false
    b.Parent = main

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = b

    local s = Instance.new("UIStroke")
    s.Color = color:Lerp(WHITE, 0.3)
    s.Transparency = 0.4
    s.Parent = b

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {
            BackgroundColor3 = color:Lerp(WHITE, 0.2)
        }):Play()
    end)

    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {
            BackgroundColor3 = color
        }):Play()
    end)

    b.MouseButton1Click:Connect(callback)

    return b
end

local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- Save position
makeButton("📍   SAVE POSITION", 105, BLUE, function()
    local root = getRoot()

    if root then
        savedPosition = root.CFrame
        status.Text = "● POSITION SAVED"
        status.TextColor3 = BLUE
        notify("Position saved successfully!")
    else
        notify("Character not found!")
    end
end)

-- Teleport
makeButton("🚀   TELEPORT", 160, PURPLE, function()
    local root = getRoot()

    if root and savedPosition then
        root.CFrame = savedPosition
        status.Text = "● TELEPORTED"
        status.TextColor3 = Color3.fromRGB(80, 255, 170)
        notify("Teleport complete!")
    elseif not savedPosition then
        notify("Save a position first!")
    else
        notify("Character not found!")
    end
end)

